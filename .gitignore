# Kotlin/JVM Project Git Ignore
# ==============================
# This file specifies intentionally untracked files that should be ignored by Git.
# Generated by Hive project setup.

# ============
# Build Output
# ============

# Compiled class files
*.class

# Compiled Kotlin classes
*.kotlin_module

# Build directories
build/
out/
production/

# Distribution files
dist/

# ============
# IDE
# ============

# IntelliJ IDEA
.idea/
*.iml
*.ipr

# VS Code
.vscode/

# Eclipse
.bin/
.settings/
.metadata/

# NetBeans
nbproject/
dist/
build/

# ============
# Logs and Temporary Files
# ============

# Log files
*.log

# Log directories
logs/

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# ============
# Archive Files
# ============

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.rar
*.7z

# ============
# System Files
# ============

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Linux
*~

# ============
# Kotlin Specific
# ============

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# Kotlin compiler cache
.kotlin_builtins_cache/

# ============
# Gradle Specific
# ============

# Gradle cache and daemon files
.gradle/

# Gradle wrapper
gradle-wrapper.jar

# Local gradle properties (may contain sensitive data)
gradle.properties.local

# ============
# Test Results
# ============

# Test results
TEST-*.xml
*.xml

# ============
# Environment Files
# ============

# Environment specific files
.env
.env.local
.env.*.local

# ============
# Documentation
# ============

# Generated documentation
docs/
api/
